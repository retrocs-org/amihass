; AmiHASS 0.3 installer. Installer 42+, AmigaOS 3.x.
(set @app-name "AmiHASS")
(set @language "english")
(if (= @icon "") (set #src (expandpath "")) (set #src (pathonly (expandpath @icon))))
(set #helper (tackon #src "SetupStartup"))
(if (<> (run (cat "\"" #helper "\" EXPORT")) 0) (abort "Cannot read AmiHASS.cfg. No files were changed."))
(set #dest (getenv "AmiHASS/InstallerService"))
(set #prefs (getenv "AmiHASS/InstallerPrefs"))
(set #startup-dir (getenv "AmiHASS/InstallerStartup"))
(set #startup (= (getenv "AmiHASS/InstallerBoot") "1"))
(set #old-dest #dest)
(set #old-prefs #prefs)
(set #old-startup-dir #startup-dir)
; Shared components live outside the visible Utilities applications.
(if (= #dest "SYS:Utilities/AmiHASS") (set #dest "SYS:AmiHASS"))
(set #installed (or (= (exists (tackon #dest "AmiHASSService") (noreq)) 1) (= (exists (tackon #prefs "AmiHASSPrefs") (noreq)) 1)))
(procedure P_DELETE (if (exists #del (noreq)) (delete #del (optional "force"))))
(procedure P_COPY
 (copyfiles (source (tackon #src #copy)) (dest #copy-dest)
  (prompt "Installing " #copy) (help @copyfiles-help) (optional "force")))
(procedure P_CATALOG
 (set #copy-dest (tackon "LOCALE:Catalogs" #lang))
 (if (<> (exists #copy-dest (noreq)) 2) (makedir #copy-dest))
 (set #copy (tackon (tackon "Catalogs" #lang) "amihass.catalog")) (P_COPY))
(procedure P_REMOVE_DOCK
 (set #del "SYS:Utilities/AmiHASSDock") (P_DELETE)
 (set #del "SYS:Utilities/AmiHASSDock.info") (P_DELETE)
 (set #del (tackon #startup-dir "AmiHASSDock")) (P_DELETE)
 (set #del (tackon #startup-dir "AmiHASSDock.info")) (P_DELETE)
 (set #del (tackon #old-startup-dir "AmiHASSDock")) (P_DELETE)
 (set #del (tackon #old-startup-dir "AmiHASSDock.info")) (P_DELETE)
 (set #del "SYS:WBStartup/AmiHASSDock") (P_DELETE)
 (set #del "SYS:WBStartup/AmiHASSDock.info") (P_DELETE))
(procedure P_STOP
 (working "Stopping the AmiHASS service...")
 (if (<> (run (cat "\"" (tackon #src "AmiHASSService") "\" STOP")) 0)
  (abort "AmiHASS did not stop. No application files were changed.")))
(procedure P_CLEAN (run (cat "\"" #helper "\" CLEAN")))
(procedure P_REMOVE_APP
 (set #del (tackon #remove-dir "AmiHASS")) (P_DELETE)
 (set #del (tackon #remove-dir "AmiHASS.info")) (P_DELETE)
 (set #del (tackon #remove-dir "AmiHASSService.info")) (P_DELETE)
 (if (or (= #action 1) (<> (expandpath #remove-dir) (expandpath #prefs))) ((set #del (tackon #remove-dir "AmiHASSPrefs")) (P_DELETE)))
 (if (or (= #action 1) (<> (expandpath #remove-dir) (expandpath #prefs))) ((set #del (tackon #remove-dir "AmiHASSPrefs.info")) (P_DELETE)))
 (if #remove-browser ((set #del (tackon #remove-dir "AmiHASSBrowser")) (P_DELETE)
 (set #del (tackon #remove-dir "AmiHASSBrowser.info")) (P_DELETE)))
 (set #del (tackon #remove-dir "AmiHASSService")) (P_DELETE)
 (set #del (tackon #remove-dir "AmiHASSFetch")) (P_DELETE)
 (set #del (tackon #remove-dir "AmiHASS.guide")) (P_DELETE)
 (set #del (tackon #remove-dir "StartInstaller")) (P_DELETE)
 (set #del (tackon #remove-dir "SetupStartup")) (P_DELETE)
 (set #del (tackon #remove-dir "Install")) (P_DELETE)
 (set #del (tackon #remove-dir "Install.info")) (P_DELETE)
 (set #del (tackon #remove-dir "Install-AmiHASS")) (P_DELETE)
 (set #del (tackon #remove-dir "Install-AmiHASS.info")) (P_DELETE)
 (set #del (tackon #remove-dir "README.txt")) (P_DELETE)
 (set #del (tackon #remove-dir "LICENSE")) (P_DELETE)
 (set #del (tackon #remove-dir "NOTICE")) (P_DELETE)
 )
(welcome "AmiHASS 0.3 - Amiga Home Assistant\nShared Home Assistant service for AmigaOS applications.")
(set #level @user-level)
(set #action 0)
; Novice mode still offers maintenance on an existing installation.
(if #installed
 ((user 1)
  (set #action (askchoice
   (prompt "AmiHASS is already installed. Choose update or uninstall.\n\nService: " #dest "\nPreferences: " #prefs)
   (help "Update keeps settings and restores the previous service state. Uninstall stops the service and asks whether to keep settings. Use Abort Install to leave without changes.")
   (choices "Update AmiHASS" "Uninstall AmiHASS") (default 0)))
  (user #level)))
(if (= #action 1)
 ((user 1)
  (set #remove-settings (askchoice
   (prompt "Keep or remove saved AmiHASS settings?\n\nKeep settings preserves the server configuration, token and dashboard layout for a later installation.\nRemove settings deletes them.")
   (help "The service is stopped before removing the applications and startup shortcut. Keep settings is the default. Use Abort Install to leave without changes.")
   (choices "Keep settings" "Remove settings") (default 0)))
  (P_STOP)
  (P_REMOVE_DOCK)
  (if #remove-settings (if (<> (run (cat "\"" #helper "\" PURGE")) 0) (abort "Settings could not be removed. Application files remain installed.")))
  (P_CLEAN)
  (set #del (tackon #prefs "AmiHASSPrefs")) (P_DELETE)
  (set #del (tackon #prefs "AmiHASSPrefs.info")) (P_DELETE)
  (set #del (tackon #startup-dir "AmiHASS")) (P_DELETE)
  (set #del (tackon #startup-dir "AmiHASS.info")) (P_DELETE)
  (set #del "SYS:Utilities/AmiHASSBrowser") (P_DELETE)
  (set #del "SYS:Utilities/AmiHASSBrowser.info") (P_DELETE)
  (set #del "SYS:Utilities/AmiHASSDashboard") (P_DELETE)
  (set #del "SYS:Utilities/AmiHASSDashboard.info") (P_DELETE)
  (set #del "LOCALE:Catalogs/svenska/amihass.catalog") (P_DELETE)
  (set #del "LOCALE:Catalogs/deutsch/amihass.catalog") (P_DELETE)
  (set #remove-browser 1)
  (set #remove-dir #dest) (P_REMOVE_APP)
  (complete 100)
  (set #result "AmiHASS stopped and uninstalled. Settings were kept.")
  (if #remove-settings (set #result "AmiHASS stopped and uninstalled. Settings were removed."))
  (message #result)
  (exit (quiet)))
 ((user #level)
  (if (<> #level 0)
   ((if (= #level 2)
     ((set #parent (askdir
       (prompt "Choose a parent drawer for shared data")
       (help "An AmiHASS drawer is created here for the service, helpers and manual. Saved settings stay in ENVARC:AmiHASS/. Preferences, Browser and Dashboard are installed separately.")
       (default (pathonly #dest))))
      (set #dest (tackon #parent "AmiHASS"))))
    (set #prefs (askdir (prompt "Choose the Preferences drawer") (help "AmiHASSPrefs and its icon are installed here.") (default #prefs)))
    (set #startup-dir (askdir (prompt "Choose the Workbench startup drawer") (help "The optional boot shortcut is installed here.") (default #startup-dir)))
    (set #startup (askbool (prompt "Start the service at system boot?") (help "An AmiHASS shortcut starts the service when Workbench starts.") (choices "Yes" "No") (default #startup))))
   (if (= #installed 0) (set #startup 1)))
  (set #dest-check (tackon (expandpath (pathonly #dest)) (fileonly #dest)))
  (if (= #dest-check (expandpath #src)) ((P_CLEAN) (abort "Run installation/update from a separate package drawer.")))
  (if (= #dest-check (expandpath #prefs)) (abort "Choose a Preferences drawer separate from the shared-data drawer."))
  (if (= #dest-check (expandpath "SYS:Utilities")) (abort "Shared data must have its own AmiHASS drawer outside SYS:Utilities."))
  (set #was-running (= (run (cat "\"" #helper "\" STATE")) 0))
  (P_STOP)
  (P_REMOVE_DOCK)
  (if (<> (exists #dest (noreq)) 2) (makedir #dest))
  (if (<> (exists #prefs (noreq)) 2) (makedir #prefs))
  (set #copy-dest #prefs)
  (set #copy "AmiHASSPrefs") (P_COPY)
  (set #copy "AmiHASSPrefs.info") (P_COPY)
  (if (<> (exists "SYS:Utilities" (noreq)) 2) (makedir "SYS:Utilities"))
  (set #copy-dest "SYS:Utilities")
  (set #copy "AmiHASSBrowser") (P_COPY)
  (set #copy "AmiHASSBrowser.info") (P_COPY)
  (set #copy "AmiHASSDashboard") (P_COPY)
  (set #copy "AmiHASSDashboard.info") (P_COPY)
  (set #lang "svenska") (P_CATALOG)
  (set #lang "deutsch") (P_CATALOG)
  (set #copy-dest #dest)
  (set #copy "AmiHASSService") (P_COPY)
  (set #copy "AmiHASSFetch") (P_COPY)
  (set #copy "AmiHASS.guide") (P_COPY)
  (set #copy "StartInstaller") (P_COPY)
  (set #copy "SetupStartup") (P_COPY)
  (set #copy "Install") (P_COPY)
  (set #copy "Install.info") (P_COPY)
  (set #copy "README.txt") (P_COPY)
  (set #copy "LICENSE") (P_COPY)
  (set #copy "NOTICE") (P_COPY)
  (set #flag "OFF") (if #startup (set #flag "ON"))
  (if (<> (run (cat "\"" (tackon #dest "SetupStartup") "\" \"" (tackon #dest "AmiHASSService") "\" " #flag " \"" #prefs "\" \"" #startup-dir "\"")) 0)
   (abort "Files copied, but configuration/startup setup failed. The service remains stopped."))
  (if (<> (expandpath #old-prefs) (expandpath #prefs))
   ((set #del (tackon #old-prefs "AmiHASSPrefs")) (P_DELETE)
    (set #del (tackon #old-prefs "AmiHASSPrefs.info")) (P_DELETE)))
  (if (<> (expandpath #old-dest) (expandpath #dest)) ((set #remove-browser (<> (expandpath #old-dest) (expandpath "SYS:Utilities"))) (set #remove-dir #old-dest) (P_REMOVE_APP)))
  (if (<> (expandpath #dest) (expandpath "SYS:Utilities"))
   ((set #del (tackon #dest "AmiHASSBrowser")) (P_DELETE)
    (set #del (tackon #dest "AmiHASSBrowser.info")) (P_DELETE)))
  (set #del (tackon #dest "AmiHASS")) (P_DELETE)
  (set #del (tackon #dest "AmiHASS.info")) (P_DELETE)
  (set #del (tackon #dest "AmiHASSService.info")) (P_DELETE)
  (set #result "AmiHASS updated. The service was left stopped.")
  (if (and #installed #was-running)
   (if (= (run (cat "\"" (tackon #dest "SetupStartup") "\" RESTART \"" (tackon #dest "AmiHASSService") "\"")) 0)
    (set #result "AmiHASS updated. The service was restarted.")
    (set #result "AmiHASS updated, but the service could not be restarted. Open Preferences to start it manually.")))
  (if (= #installed 0)
   (set #result "AmiHASS 0.3 installed. The service is stopped."))
  (set #boot-result "Disabled")
  (if #startup (set #boot-result (cat "Enabled - " #startup-dir)))
  (P_CLEAN)
  (complete 100)
  ; MESSAGE is suppressed in Novice mode. Force this final page in every mode.
  (user 1)
  (message #result
   "\n\nShared data and service: " #dest
   "\nPreferences: " (tackon #prefs "AmiHASSPrefs")
   "\nBrowser and Dashboard: SYS:Utilities/"
   "\nBoot startup: " #boot-result
   "\nSettings: ENVARC:AmiHASS/"
   "\n\nOpen Preferences manually to configure Server Settings and start"
   " the service, or manage its settings. Choose Server data or Sample data."
   "\nOpen AmiHASSBrowser to explore devices."
   "\nOpen AmiHASSDashboard to build your layout.")
  (if (= #installed 0)
   (if (askbool
    (prompt "Open AmiHASS Preferences now?")
    (help "Configure your server or choose Sample data, then start the service. Choose No to open Preferences later.")
    (choices "Yes" "No") (default 0))
    (if (<> (run (cat "\"" (tackon #dest "SetupStartup") "\" OPEN \"" (tackon #prefs "AmiHASSPrefs") "\"")) 0)
     (message "Preferences could not be opened. Open it manually from " #prefs "."))))
  (exit (quiet))))
